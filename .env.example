# Copy to .env and replace every value marked CHANGE. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development           # development | production (production enforces non-default secrets, hides /docs)
LOG_LEVEL=INFO

# --- Secrets (CHANGE) ---
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters_long
INTERNAL_SECRET=CHANGE_ME_gateway_to_service_shared_secret
SERVICE_TOKEN=CHANGE_ME_service_to_service_token
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
METRICS_TOKEN=                    # optional: require "Authorization: Bearer <token>" on /metrics

# --- Gateway behaviour ---
ALLOW_REGISTRATION=true
RATE_LIMIT_ALGORITHM=sliding_window       # sliding_window | token_bucket
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=10             # login/register/refresh, per client IP
LOAD_BALANCER_STRATEGY=round_robin        # round_robin | least_connections | random
TRUST_FORWARDED_FOR=false                 # true ONLY behind a trusted proxy that sets X-Forwarded-For
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Published ports ---
GATEWAY_PORT=8000
FRONTEND_PORT=3000
POSTGRES_USER=gateway
